@model SearchPageViewModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? "Tìm kiếm" : $"Tìm kiếm: {Model.Query}";
    ViewData["Description"] = "Tìm kiếm các bài viết trên VNews.";
    ViewData["PaginationAction"] = "Search";
    ViewData["PaginationQuery"] = Model.Query;
}
<div class="container listing-page editorial-listing search-page">
    <nav class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a> &rsaquo; Tìm kiếm</nav>
    <h1 class="listing-page__title search-page__title">Tìm kiếm</h1>
    <form class="search-page-form" asp-controller="Search" asp-action="Index" method="get" role="search">
        <label for="page-search" class="search-page-form__label">Từ khóa</label>
        <div><input id="page-search" name="q" value="@Model.Query" type="search" maxlength="120" placeholder="Tên bài viết, chủ đề..." required /><button type="submit">Tìm kiếm</button></div>
    </form>
    @if (string.IsNullOrWhiteSpace(Model.Query))
    {
        <div class="empty-state"><p>Nhập từ khóa để tìm bài viết đã xuất bản.</p></div>
    }
    else if (Model.Articles.Items.Count == 0)
    {
        <div class="empty-state"><p>Không tìm thấy bài viết phù hợp với “@Model.Query”. Thử từ khóa khác nhé.</p></div>
    }
    else
    {
        <p class="search-count">Tìm thấy <strong>@Model.Articles.TotalCount</strong> kết quả cho “@Model.Query”.</p>
        <div class="editorial-listing__articles">
            @foreach (var article in Model.Articles.Items)
            {
                @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = article, Layout = ArticleCardLayout.StoryRow })
            }
        </div>
        @await Html.PartialAsync("_Pagination", Model.Articles)
    }
</div>
