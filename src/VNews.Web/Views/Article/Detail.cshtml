@model ArticleDetailPageViewModel
@{
    var article = Model.Article;
    var related = Model.RelatedArticles;
    ViewData["Title"] = article.Title;
    ViewData["Description"] = article.Summary;
}
@section Head {
    <link rel="stylesheet" href="~/css/comments.css" asp-append-version="true" />
}
<div class="container article-layout">
    <div class="article-layout__main article-page">
        <div class="article-topbar">
            <nav class="breadcrumb" aria-label="Đường dẫn">
                @if (article.CategoryParentSlug is not null)
                {
                    <a asp-controller="Category" asp-action="Index" asp-route-slug="@article.CategoryParentSlug">@article.CategoryParentName</a> <span aria-hidden="true">›</span>
                }
                <a asp-controller="Category" asp-action="Index" asp-route-slug="@article.CategorySlug">@article.CategoryName</a>
            </nav>
            @if (article.PublishedAt is DateTime publishedAt)
            {
                <time class="article-topbar__date" datetime="@VietnamTime.ToIso(publishedAt)">@VietnamTime.FormatLong(publishedAt)</time>
            }
        </div>
        <article class="article-detail" data-news-article data-news-id="@article.Id" data-news-slug="@article.Slug" data-news-title="@article.Title" data-news-image="@article.CoverImageUrl">
            <h1 class="article-detail__title">@article.Title</h1>
            <p class="article-byline">
                @if (!string.IsNullOrWhiteSpace(article.AuthorName)) { <span class="article-byline__item">Tác giả: <strong>@article.AuthorName</strong></span> }
                <span class="article-byline__item">@Model.ReadMinutes phút đọc</span>
                <a class="article-byline__item article-byline__link" href="#binh-luan">@Model.Comments.TotalVisible bình luận</a>
            </p>
            <p class="article-detail__summary" id="article-summary">@article.Summary</p>
            <div class="article-tools" role="group" aria-label="Công cụ đọc bài">
                <button type="button" class="article-tool" data-action="share" aria-label="Chia sẻ bài viết">Chia sẻ</button>
                <button type="button" class="article-tool" data-action="speak" aria-pressed="false">▶ Nghe tóm tắt</button>
                <button type="button" class="article-tool" data-action="font-down" aria-label="Giảm cỡ chữ">A−</button>
                <button type="button" class="article-tool" data-action="font-up" aria-label="Tăng cỡ chữ">A+</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(article.CoverImageUrl))
            {
                <figure class="article-cover-wrap">
                    <img class="article-detail__cover" src="@article.CoverImageUrl" alt="Ảnh minh họa: @article.Title" fetchpriority="high" />
                    <figcaption>@(string.IsNullOrWhiteSpace(article.CoverCaption) ? "Ảnh minh họa" : article.CoverCaption)</figcaption>
                </figure>
            }
            <div class="article-detail__body" id="article-body">
                @* CMS sanitizes HTML on save. Existing seeded body is generated within the application. *@
                @Html.Raw(ArticleBodyFormatter.ToHtml(article.Body))
            </div>
            @if (article.GalleryImages.Count > 0)
            {
                @* The editor's pictures, below the text. The grid adapts to how many there are (1, 2, 3, 4, or more). *@
                <section class="article-gallery article-gallery--@(Math.Min(article.GalleryImages.Count, 5))" aria-label="Ảnh trong bài">
                    @for (var i = 0; i < article.GalleryImages.Count; i++)
                    {
                        <a class="article-gallery__item" href="@article.GalleryImages[i]" target="_blank" rel="noopener">
                            <img src="@article.GalleryImages[i]" alt="Ảnh @(i + 1): @article.Title" loading="lazy" />
                        </a>
                    }
                </section>
            }
            @if (!string.IsNullOrWhiteSpace(article.AuthorName))
            {
                <p class="article-signoff"><span class="article-signoff__name">@article.AuthorName</span></p>
            }
            @if (related.FirstOrDefault(r => r.Id != article.Id) is { } alsoRead)
            {
                <aside class="article-also" aria-label="Bài liên quan">
                    <a class="article-also__link" asp-controller="Article" asp-action="Detail" asp-route-slug="@alsoRead.Slug">
                        <img class="article-also__image" src="@Url.CoverOrFallback(alsoRead.CoverImageUrl)" alt="" width="160" height="100" loading="lazy" decoding="async" />
                        <span class="article-also__text">
                            <strong class="article-also__title">@alsoRead.Title</strong>
                            <span class="article-also__summary">@alsoRead.Summary</span>
                        </span>
                    </a>
                </aside>
            }
            <div class="article-bottom-actions">
                <a class="article-back-link article-back-btn" asp-controller="Category" asp-action="Index" asp-route-slug="@article.CategorySlug"><span aria-hidden="true">←</span> Trở lại @article.CategoryName</a>
                <button type="button" class="article-back-btn" data-action="save" data-label-off="☆ Lưu" data-label-on="★ Đã lưu" aria-pressed="false">☆ Lưu</button>
                <button type="button" class="article-bottom-actions__share" data-action="share">Chia sẻ bài viết</button>
            </div>
        </article>

        @if (Model.Neighbors.Previous is not null || Model.Neighbors.Next is not null)
        {
            <nav class="article-neighbors" aria-label="Bài trước và bài sau trong chuyên mục">
                @if (Model.Neighbors.Previous is { } prev)
                {
                    <a class="article-neighbors__link article-neighbors__link--prev" asp-controller="Article" asp-action="Detail" asp-route-slug="@prev.Slug" rel="prev"><span class="article-neighbors__label">‹ Bài trước</span><span class="article-neighbors__title">@prev.Title</span></a>
                }
                @if (Model.Neighbors.Next is { } next)
                {
                    <a class="article-neighbors__link article-neighbors__link--next" asp-controller="Article" asp-action="Detail" asp-route-slug="@next.Slug" rel="next"><span class="article-neighbors__label">Bài sau ›</span><span class="article-neighbors__title">@next.Title</span></a>
                }
            </nav>
        }

        <partial name="_Comments" model="Model" />

        @if (article.Tags.Count > 0)
        {
            <nav class="article-tags" aria-label="Chủ đề của bài viết">
                <span class="article-tags__label">Tags:</span>
                @foreach (var tag in article.Tags)
                {
                    <a class="article-tags__item" asp-controller="Tag" asp-action="Index" asp-route-slug="@tag.Slug">@tag.Name</a>
                }
            </nav>
        }

        @* The first related story already sits inside the article; the grid lists the next ones so nothing repeats. *@
        @if (related.Skip(1).Any())
        {
            <section class="article-related" aria-labelledby="article-related-title">
                <h2 id="article-related-title">Tin cùng chuyên mục</h2>
                <div class="article-related__grid">
                    @foreach (var relatedArticle in related.Skip(1))
                    {
                        <a class="article-related__card" asp-controller="Article" asp-action="Detail" asp-route-slug="@relatedArticle.Slug">
                            <img src="@Url.CoverOrFallback(relatedArticle.CoverImageUrl)" alt="" width="300" height="200" loading="lazy" decoding="async" />
                            <span>@relatedArticle.Title</span>
                        </a>
                    }
                </div>
            </section>
        }
    </div>
    @if (Model.MostViewed.Count > 0)
    {
        <aside class="article-layout__aside" aria-label="Xem nhiều">
            <partial name="_PopularSidebar" model="Model.MostViewed" />
        </aside>
    }
</div>
