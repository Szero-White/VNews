@using VNews.Web.Helpers
@model AuditPageViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Nhật ký hoạt động";
    ViewData["AppNav"] = "audit";
    ViewData["Crumbs"] = new (string, string?)[] { ("Quản trị", null), ("Nhật ký hoạt động", null) };
    var log = Model.Page;
    var query = new Dictionary<string, string?>
    {
        ["op"] = Model.Action, ["entity"] = Model.Entity, ["user"] = Model.User, ["q"] = Model.Query,
        ["from"] = Model.From?.ToString("yyyy-MM-dd"), ["to"] = Model.To?.ToString("yyyy-MM-dd"),
    };
}
<div class="page-head">
    <div class="page-head__text">
        <h1 class="app-page-title">Nhật ký hoạt động</h1>
        <p class="page-head__sub">Ai đã làm gì, lúc nào: tạo, sửa, gửi duyệt, xuất bản, xóa, khôi phục, khóa tài khoản... Mới nhất ở trên. Nhật ký chỉ để xem, không sửa hay xóa được.</p>
    </div>
</div>
<section class="card">
    <div class="card__head">
        <h2 class="card__title" id="audit-title">Lịch sử thao tác</h2>
        <span class="card__hint"><span data-list-total>@log.TotalCount</span> bản ghi</span>
    </div>
    <form method="get" class="filters filters--wide" role="search" aria-label="Lọc nhật ký">
        <div class="filters__search">
            <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
            <label for="q" class="sr-only">Tìm trong nhật ký</label>
            <input id="q" name="q" value="@Model.Query" maxlength="100" class="app-input" placeholder="Tìm theo chi tiết, người thực hiện hoặc mã đối tượng" />
        </div>
        <label for="op" class="sr-only">Thao tác</label>
        <select id="op" name="op" class="app-select" data-autosubmit>
            <option value="">Tất cả thao tác</option>
            @foreach (var a in Model.Options.Actions)
            {
                <option value="@a" selected="@(Model.Action == a)">@AuditLabels.Action(a)</option>
            }
        </select>
        <label for="entity" class="sr-only">Đối tượng</label>
        <select id="entity" name="entity" class="app-select" data-autosubmit>
            <option value="">Tất cả đối tượng</option>
            @foreach (var e in Model.Options.EntityTypes)
            {
                <option value="@e" selected="@(Model.Entity == e)">@AuditLabels.Entity(e)</option>
            }
        </select>
        <label for="user" class="sr-only">Người thực hiện</label>
        <select id="user" name="user" class="app-select" data-autosubmit>
            <option value="">Tất cả người dùng</option>
            @foreach (var u in Model.Options.Users)
            {
                <option value="@u" selected="@(Model.User == u)">@u</option>
            }
        </select>
        <div class="filters__dates" role="group" aria-label="Khoảng ngày">
            <label for="from" class="filters__datelabel">Từ ngày</label>
            <input id="from" name="from" type="date" class="app-input" value="@Model.From?.ToString("yyyy-MM-dd")" />
            <label for="to" class="filters__datelabel">đến</label>
            <input id="to" name="to" type="date" class="app-input" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn--secondary">Lọc</button>
        @if (Model.HasFilter)
        {
            <a asp-action="Index" class="btn btn--ghost">Xóa bộ lọc</a>
        }
    </form>
    @if (log.Items.Count == 0)
    {
        <div class="empty">
            <svg class="icon" aria-hidden="true"><use href="#i-log" /></svg>
            <p class="empty__title">@(Model.HasFilter ? "Không có bản ghi nào khớp bộ lọc" : "Chưa có hoạt động nào được ghi lại")</p>
            @if (Model.HasFilter) { <a asp-action="Index" class="btn btn--secondary">Xóa bộ lọc</a> }
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--cards">
                <thead><tr><th scope="col">Thời gian</th><th scope="col">Người thực hiện</th><th scope="col">Thao tác</th><th scope="col">Đối tượng</th><th scope="col">Chi tiết</th></tr></thead>
                <tbody>
                    @foreach (var a in log.Items)
                    {
                        <tr>
                            <td data-label="Thời gian" style="white-space:nowrap">@a.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td data-label="Người thực hiện">@a.UserDisplayName</td>
                            <td data-label="Thao tác"><span class="badge badge--draft">@AuditLabels.Action(a.Action)</span></td>
                            <td data-label="Đối tượng">@AuditLabels.Entity(a.EntityType) #@a.EntityId</td>
                            <td data-label="Chi tiết">@a.Detail</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AppPager" model="@(new AppPagerModel { Page = log.Page, PageSize = log.PageSize, TotalCount = log.TotalCount, Controller = "CmsAudit", Query = query, Noun = "bản ghi" })" />
    }
</section>
