@model ArticleCardViewModel
@{
    var a = Model.Article;
}

@switch (Model.Layout)
{
    case "image-left":
        <article class="hero-lead">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="hero-lead__image-link" aria-label="Đọc bài: @a.Title">
                <img src="@a.CoverImageUrl" alt="@a.Title" fetchpriority="high" decoding="async" />
            </a>
            <div class="hero-lead__content">
                <span class="hero-lead__category">@a.CategoryName</span>
                <h1 class="hero-lead__title">
                    <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
                </h1>
                <p class="hero-lead__summary">@a.Summary</p>
                <div class="article-meta hero-lead__meta">
                    <span>@a.AuthorName</span>
                    <span>@a.PublishedAt?.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </article>
        break;

    case "hero-side-item":
        <article class="hero-side__item">
            <h2 class="hero-side__title">
                <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
            </h2>
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="hero-side__image-link" aria-label="Đọc bài: @a.Title">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            </a>
        </article>
        break;

    case "story-row":
        <article class="story-row">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="story-row__image-link">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            </a>
            <div class="story-row__body">
                <h3 class="story-row__title">
                    <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
                </h3>
                <p class="story-row__summary">@a.Summary</p>
                <div class="article-meta">
                    <span>@a.CategoryName</span>
                    <span>@a.PublishedAt?.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </article>
        break;

    case "category-lead":
        <article class="category-lead">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="category-lead__image-link">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            </a>
            <h3 class="category-lead__title">
                <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
            </h3>
            <p class="category-lead__summary">@a.Summary</p>
        </article>
        break;

    case "photo-feature":
        <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="photo-feature">
            <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
        </a>
        break;

    case "photo-feature-aside":
        <article class="photo-feature-aside">
            <h3 class="photo-feature-aside__title">
                <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
            </h3>
            <p class="photo-feature-aside__summary">@a.Summary</p>
            <span class="photo-feature-aside__meta">@a.CategoryName</span>
        </article>
        break;

    case "spotlight-feature":
        <article class="spotlight-feature">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="spotlight-feature__image-link">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            </a>
            <div class="spotlight-feature__body">
                <span class="spotlight-feature__category">@a.CategoryName</span>
                <h3 class="spotlight-feature__title">
                    <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
                </h3>
                <p class="spotlight-feature__summary">@a.Summary</p>
            </div>
        </article>
        break;

    case "stream-compact":
        <li class="stream-compact">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="stream-compact__image-link">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            </a>
            <div class="stream-compact__body">
                <h3 class="stream-compact__title">
                    <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
                </h3>
                <p class="stream-compact__summary">@a.Summary</p>
            </div>
        </li>
        break;

    case "category-lead-row1":
        <article class="category-lead-row1">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="category-lead-row1__image-link">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            </a>
            <div class="category-lead-row1__body">
                <h3 class="category-lead-row1__title">
                    <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
                </h3>
                <p class="category-lead-row1__summary">@a.Summary</p>
            </div>
        </article>
        break;

    case "category-side-text":
        <article class="category-side-text">
            <h3 class="category-side-text__title">
                <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
            </h3>
        </article>
        break;

    case "list-item":
        <li class="list-item">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="list-item__link">@a.Title</a>
        </li>
        break;

    case "list-item-thumb":
        <li class="list-item-thumb">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="list-item-thumb__img-link">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            </a>
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="list-item-thumb__title">@a.Title</a>
        </li>
        break;

    case "photo-grid":
        <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="photo-grid__item" aria-label="@a.Title">
            <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            <span class="photo-grid__caption">@a.Title</span>
        </a>
        break;

    case "spotlight":
        <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="spotlight-card">
            <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            <div class="spotlight-card__overlay">
                <span class="spotlight-card__category">@a.CategoryName</span>
                <h3 class="spotlight-card__title">@a.Title</h3>
            </div>
        </a>
        break;

    case "podcast-demo":
        <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="podcast-card" aria-label="@a.Title (minh hoạ, chưa có audio thật)">
            <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            <span class="podcast-card__play" aria-hidden="true">▶</span>
            <span class="podcast-card__duration">12:34</span>
            <span class="podcast-card__title">@a.Title</span>
        </a>
        break;

    case "text-only":
        <article class="hero-side__opinion">
            @if (!string.IsNullOrWhiteSpace(Model.Eyebrow))
            {
                <span class="hero-side__eyebrow">@Model.Eyebrow</span>
            }
            <h2 class="hero-side__title">
                <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
            </h2>
            <p class="hero-side__aside-copy">Khám phá thêm những bài viết đang được bạn đọc chú ý.</p>
        </article>
        break;

    default: // image-top
        <article class="card">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="card__image-link">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            </a>
            <h3 class="card__title">
                <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
            </h3>
        </article>
        break;
}
