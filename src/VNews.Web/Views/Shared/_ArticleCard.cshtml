@model ArticleCardViewModel
@{
    var a = Model.Article;
}

@switch (Model.Layout)
{
    case "image-left":
        <article class="hero-lead">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="hero-lead__image-link" aria-label="Đọc bài: @a.Title">
                <img src="@a.CoverImageUrl" alt="@a.Title" fetchpriority="high" decoding="async" />
            </a>
            <div class="hero-lead__content">
                <span class="hero-lead__category">@a.CategoryName</span>
                <h1 class="hero-lead__title">
                    <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
                </h1>
                <p class="hero-lead__summary">@a.Summary</p>
                <div class="article-meta hero-lead__meta">
                    <span>@a.AuthorName</span>
                    <span>@a.PublishedAt?.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </article>
        break;

    case "hero-side-item":
        <article class="hero-side__item">
            <h2 class="hero-side__title">
                <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
            </h2>
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="hero-side__image-link" aria-label="Đọc bài: @a.Title">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            </a>
        </article>
        break;

    case "story-row":
        <article class="story-row">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="story-row__image-link">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            </a>
            <div class="story-row__body">
                <h3 class="story-row__title">
                    <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
                </h3>
                <p class="story-row__summary">@a.Summary</p>
                <div class="article-meta">
                    <span>@a.CategoryName</span>
                    <span>@a.PublishedAt?.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </article>
        break;

    case "image-top-large":
        <article class="stream-card">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="stream-card__image-link">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            </a>
            <div class="stream-card__body">
                <span class="stream-card__category">@a.CategoryName</span>
                <h3 class="stream-card__title">
                    <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
                </h3>
                <p class="stream-card__summary">@a.Summary</p>
                <div class="article-meta">
                    <span>@a.AuthorName</span>
                    <span>@a.PublishedAt?.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </article>
        break;

    case "photo-grid":
        <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="photo-grid__item" aria-label="@a.Title">
            <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            <span class="photo-grid__caption">@a.Title</span>
        </a>
        break;

    case "spotlight":
        <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="spotlight-card">
            <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            <div class="spotlight-card__overlay">
                <span class="spotlight-card__category">@a.CategoryName</span>
                <h3 class="spotlight-card__title">@a.Title</h3>
            </div>
        </a>
        break;

    case "podcast-demo":
        <article class="podcast-card">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="podcast-card__image-link">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
                <span class="podcast-card__play" aria-hidden="true">▶</span>
            </a>
            <div class="podcast-card__body">
                <h3 class="podcast-card__title">
                    <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
                </h3>
                <span class="podcast-card__duration">Tập minh hoạ · 12:34 (chưa có audio thật)</span>
            </div>
        </article>
        break;

    case "text-only":
        <article class="hero-side__opinion">
            @if (!string.IsNullOrWhiteSpace(Model.Eyebrow))
            {
                <span class="hero-side__eyebrow">@Model.Eyebrow</span>
            }
            <h2 class="hero-side__title">
                <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
            </h2>
            <p class="hero-side__aside-copy">Khám phá thêm những bài viết đang được bạn đọc chú ý.</p>
        </article>
        break;

    default: // image-top
        <article class="card">
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug" class="card__image-link">
                <img src="@a.CoverImageUrl" alt="@a.Title" loading="lazy" decoding="async" />
            </a>
            <h3 class="card__title">
                <a asp-controller="Article" asp-action="Detail" asp-route-slug="@a.Slug">@a.Title</a>
            </h3>
        </article>
        break;
}
