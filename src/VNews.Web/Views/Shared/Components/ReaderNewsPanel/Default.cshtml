@using VNews.Application.DTOs
@model IReadOnlyList<ArticleSummaryDto>
<details class="reader-news-panel" id="reader-news-panel">
    <summary class="reader-news-panel__trigger" title="Tin mới và đã xem" aria-label="Mở bảng tin mới và đã xem">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 9h18c0-1-3-2-3-9ZM10 21h4"/></svg>
    </summary>
    <div class="reader-news-panel__popup" aria-label="Bảng tin VNews">
        <div class="reader-news-panel__tabs" role="tablist" aria-label="Bảng tin">
            <button type="button" id="reader-news-tab-latest" role="tab" data-reader-news-tab="latest" aria-selected="true" aria-controls="reader-news-content-latest">Tin mới</button>
            <button type="button" id="reader-news-tab-seen" role="tab" data-reader-news-tab="seen" aria-selected="false" aria-controls="reader-news-content-seen" tabindex="-1">Tin đã xem</button>
        </div>
        <section class="reader-news-panel__content" id="reader-news-content-latest" role="tabpanel" aria-labelledby="reader-news-tab-latest">
            @if (Model.Count == 0)
            {
                <p class="reader-news-panel__empty">Chưa có bài viết mới được xuất bản.</p>
            }
            else
            {
                <ol class="reader-news-panel__list">
                    @foreach (var item in Model)
                    {
                        <li>
                            <span class="reader-news-panel__category">@item.CategoryName</span>
                            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@item.Slug">@item.Title</a>
                        </li>
                    }
                </ol>
            }
            <a class="reader-news-panel__footlink" asp-controller="Home" asp-action="Latest">Xem tất cả tin mới →</a>
        </section>
        <section class="reader-news-panel__content" id="reader-news-content-seen" role="tabpanel" aria-labelledby="reader-news-tab-seen" hidden>
            <ol class="reader-news-panel__list" id="reader-news-recent-list"></ol>
            <p class="reader-news-panel__empty" id="reader-news-recent-empty">Bạn chưa đọc bài nào trên thiết bị này.</p>
            <a class="reader-news-panel__footlink" asp-controller="Home" asp-action="Saved">Bài đã lưu →</a>
        </section>
    </div>
</details>
