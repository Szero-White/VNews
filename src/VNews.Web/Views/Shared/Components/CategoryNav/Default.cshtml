@using VNews.Application.DTOs
@model IReadOnlyList<CategoryDto>

<nav class="category-nav">
    <ul class="category-nav__list">
        @foreach (var category in Model)
        {
            <li><a asp-controller="Category" asp-action="Index" asp-route-slug="@category.Slug">@category.Name</a></li>
        }
    </ul>
</nav>
