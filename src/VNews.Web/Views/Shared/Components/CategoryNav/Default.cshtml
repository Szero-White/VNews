@model CategoryNavViewModel

<nav class="category-nav">
    <ul class="category-nav__list">
        @foreach (var category in Model.Categories)
        {
            var isActive = string.Equals(category.Slug, Model.ActiveSlug, StringComparison.OrdinalIgnoreCase);
            <li><a asp-controller="Category" asp-action="Index" asp-route-slug="@category.Slug" aria-current="@(isActive ? "page" : null)">@category.Name</a></li>
        }
    </ul>
</nav>
