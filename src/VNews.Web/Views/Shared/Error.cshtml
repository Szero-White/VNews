@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
    var code = Context.Response.StatusCode;
    var (heading, message) = code switch
    {
        403 => ("403 — Không có quyền truy cập", "Tài khoản của bạn không có quyền thực hiện thao tác này."),
        404 => ("404 — Không tìm thấy", "Nội dung bạn tìm không tồn tại hoặc đã bị gỡ bỏ."),
        409 => ("409 — Xung đột dữ liệu", "Dữ liệu vừa bị thay đổi hoặc không còn phù hợp với thao tác này. Vui lòng tải lại trang và thử lại."),
        _ => ("Có lỗi xảy ra", "Hệ thống gặp sự cố khi xử lý yêu cầu. Vui lòng thử lại sau.")
    };
}

<div class="container empty-state-page">
    <h1>@heading</h1>
    <p>@message</p>
    @if (Model.ShowRequestId)
    {
        <p>Mã tra cứu lỗi: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index">Quay về trang chủ</a>
</div>
