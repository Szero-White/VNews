@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // Keep public editorial routes explicit; CMS and account layouts are unaffected.
    var isHomepage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
    var isSavedPage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Saved", StringComparison.OrdinalIgnoreCase);
    var isArticle = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Article", StringComparison.OrdinalIgnoreCase);
    var isCategory = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Category", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VNews</title>
    <partial name="_Favicon" />
    <meta name="description" content="@(ViewData["Description"] ?? "VNews - Website tin tức minh họa và portfolio ASP.NET Core MVC.")" />
    <meta name="theme-color" content="#a61b46" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="vnews-csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
        <meta name="vnews-bookmarks-mode" content="account" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Merriweather (SIL Open Font License, free for any use): headline typeface, matched to the
         editorial reference's measured computed style (font-family: Merriweather, serif; 700). -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&display=swap" media="print" data-font-swap />
    <link rel="stylesheet" href="~/css/brand-logo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/home-sections.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/listing-article.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/page-chrome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/editorial.css" asp-append-version="true" />
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index")
    {
        <link rel="stylesheet" href="~/css/homepage-v5.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/home-technology-feature.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/home-business-feature.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/auth-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reader-login-dialog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reader-news-panel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/top-ad-banner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mega-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/category-submenu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/demo-login.css" asp-append-version="true" />
    @if (isArticle || isCategory)
    {
        <link rel="stylesheet" href="~/css/popular-list.css" asp-append-version="true" />
    }
    @if (isArticle)
    {
        <link rel="stylesheet" href="~/css/article-page.css" asp-append-version="true" />
    }
    @if (isCategory)
    {
        <link rel="stylesheet" href="~/css/category-page.css" asp-append-version="true" />
    }
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Pages")
    {
        <link rel="stylesheet" href="~/css/static-pages.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Head", required: false)
    <script src="~/js/font-swap.js" asp-append-version="true" defer></script>
</head>
<body class="@(isHomepage ? "page-home" : isArticle ? "page-article" : isCategory ? "page-category" : "")">
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng, đến nội dung</a>
    <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

    @* Only the homepage carries a first-party banner above the masthead. Every other page starts with the header,
       like the reference, so navigation and content sit where readers expect them. *@
    @if (isHomepage && Configuration.GetValue("Features:ShowDemoAdSlot", true))
    {
        <partial name="_TopAdBanner" />
    }

    <partial name="_SiteHeader" />

    <partial name="_UtilityDrawer" />

    <partial name="_PrimaryNav" />

    <div class="mobile-weather-row">
        @await Component.InvokeAsync("WeatherWidget")
    </div>

    <main class="site-main" id="main-content">
        @RenderBody()
    </main>

    <partial name="_SiteFooter" />
    @if (User.Identity?.IsAuthenticated != true)
    {
        <partial name="_ReaderLoginDialog" />
    }
    <partial name="_DemoBadge" />
    <button id="back-to-top" class="back-to-top" type="button" aria-label="Lên đầu trang" hidden>↑</button>
    <div id="site-toast" class="site-toast" role="status" aria-live="polite" hidden></div>

    <script src="~/js/site/core.js" asp-append-version="true"></script>
    <script src="~/js/site/chrome.js" asp-append-version="true"></script>
    @* The sign-in dialog only exists for visitors who are not signed in. *@
    <script src="~/js/site/login-dialog.js" asp-append-version="true"></script>
    <script src="~/js/site/reading-history.js" asp-append-version="true"></script>
    @* Saving and the reading tools belong to the article page (and the saved-articles list) only. *@
    @if (isArticle || isSavedPage)
    {
        <script src="~/js/site/bookmarks.js" asp-append-version="true"></script>
    }
    @if (isArticle)
    {
        <script src="~/js/site/article-tools.js" asp-append-version="true"></script>
    }
    <script src="~/js/mega-menu.js" asp-append-version="true"></script>
    <script src="~/js/category-submenu.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
