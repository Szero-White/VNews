@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VNews</title>
    <meta name="description" content="@(ViewData["Description"] ?? "VNews - Website tin tức minh họa và portfolio ASP.NET Core MVC.")" />
    <meta name="theme-color" content="#a3123a" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="vnews-csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
        <meta name="vnews-bookmarks-mode" content="account" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Merriweather (SIL Open Font License, free for any use): headline typeface, matched to the
         editorial reference's measured computed style (font-family: Merriweather, serif; 700). -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/editorial.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reader-login-dialog.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng, đến nội dung</a>
    <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

    @* Original VNews house campaign occupies the same top-of-page position as a
       typical publisher masthead promotion. No third-party ad or copied creative. *@
    @if (Configuration.GetValue("Features:ShowDemoAdSlot", true))
    {
        <aside class="house-promo" aria-label="Giới thiệu VNews">
            <div class="house-promo__inner">
                <div class="house-promo__copy">
                    <span class="house-promo__eyebrow">VNEWS · KHÁM PHÁ MỖI NGÀY</span>
                    <strong class="house-promo__headline">Thêm một góc nhìn<br />về thế giới quanh ta.</strong>
                    <span class="house-promo__support">Thời sự · Kinh doanh · Công nghệ · Đời sống</span>
                    <a asp-controller="Home" asp-action="Latest" class="house-promo__link">Đọc tin mới nhất <span aria-hidden="true">→</span></a>
                </div>
                <div class="house-promo__art" aria-hidden="true"><span></span><span></span><span></span></div>
            </div>
        </aside>
    }

    <header class="masthead">
        <div class="masthead__inner">
            <button class="masthead__menu-toggle" type="button" aria-label="Mở menu tiện ích" aria-controls="utility-drawer" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>

            <details class="masthead__search masthead__search--mobile-left">
                <summary aria-label="Mở tìm kiếm" title="Tìm kiếm">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                        <circle cx="10.8" cy="10.8" r="6.7"></circle>
                        <path d="m16 16 4.5 4.5"></path>
                    </svg>
                </summary>
                <form class="masthead__search-form" asp-controller="Search" asp-action="Index" method="get" role="search">
                    <input type="search" name="q" placeholder="Tìm kiếm bài viết..." value="@Context.Request.Query["q"]" aria-label="Tìm kiếm bài viết" required />
                    <button type="submit">Tìm</button>
                </form>
            </details>

            <div class="masthead__identity">
                <a class="masthead__brand" asp-controller="Home" asp-action="Index" aria-label="VNews - Trang chủ">V<span>News</span></a>
                <span class="masthead__motto">Bản tin dành cho người thích khám phá</span>
            </div>

            <div class="masthead__right">
                <span class="masthead__hide-mobile">@await Component.InvokeAsync("WeatherWidget")</span>
                <span id="today-date" class="masthead__date masthead__hide-mobile"></span>
                <span class="masthead__separator masthead__hide-mobile" aria-hidden="true"></span>
                <a class="masthead__utility-link masthead__hide-mobile" asp-controller="Home" asp-action="Latest">Tin mới nhất</a>
                <span class="masthead__separator masthead__hide-mobile" aria-hidden="true"></span>
                <a class="masthead__utility-link masthead__hide-mobile" asp-controller="Home" asp-action="Saved">Đã lưu</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin") || User.IsInRole("Editor") || User.IsInRole("Author"))
                    {
                        <a class="masthead__utility-link masthead__hide-mobile" asp-controller="CmsArticles" asp-action="Index">Tòa soạn</a>
                    }
                    <a class="masthead__utility-link" asp-controller="Account" asp-action="Profile">Tài khoản</a>
                }
                else
                {
                    <a class="masthead__utility-link" asp-controller="Account" asp-action="Login" data-reader-login-open>Đăng nhập</a>
                }
            </div>
        </div>
    </header>

    <div id="utility-drawer" class="utility-drawer">
        <div class="utility-drawer__inner">
            <a asp-controller="Home" asp-action="Latest">Tin mới nhất</a>
            <a asp-controller="Home" asp-action="Saved">Đã lưu</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Account" asp-action="Profile">Tài khoản của tôi</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Editor") || User.IsInRole("Author"))
                {
                    <a asp-controller="CmsArticles" asp-action="Index">Tòa soạn</a>
                }
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" data-reader-login-open>Đăng nhập</a>
                <a asp-controller="Account" asp-action="Register">Đăng ký</a>
            }
        </div>
    </div>

    <nav id="primary-nav" class="primary-nav">
        <div class="primary-nav__inner">
            <a class="primary-nav__home" asp-controller="Home" asp-action="Index" aria-label="Trang chủ" title="Trang chủ">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3 2 11h2v10h6v-7h4v7h6V11h2L12 3z" /></svg>
            </a>
            <a class="primary-nav__latest" asp-controller="Home" asp-action="Latest">Mới nhất</a>
            @await Component.InvokeAsync("CategoryNav")
        </div>
        <button type="button" id="primary-nav-next" class="primary-nav__arrow primary-nav__arrow--next" aria-label="Xem thêm chuyên mục" hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
        </button>
    </nav>

    <div class="mobile-weather-row">
        @await Component.InvokeAsync("WeatherWidget")
    </div>

    <main class="site-main" id="main-content">
        @RenderBody()
    </main>

    <partial name="_SiteFooter" />
    @if (User.Identity?.IsAuthenticated != true)
    {
        <partial name="_ReaderLoginDialog" />
    }
    <button id="back-to-top" class="back-to-top" type="button" aria-label="Lên đầu trang" hidden>↑</button>
    <div id="site-toast" class="site-toast" role="status" aria-live="polite" hidden></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
