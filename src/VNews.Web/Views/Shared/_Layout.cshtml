<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VNews</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="utility-strip">
        <div class="utility-strip__inner">
            <span id="today-date"></span>
            <span class="utility-strip__tagline">Tin tức minh họa — không phải nguồn tin thật</span>
        </div>
    </div>

    <header class="masthead">
        <div class="masthead__inner">
            <a class="masthead__brand" asp-controller="Home" asp-action="Index">VNews</a>

            <form class="masthead__search" asp-controller="Search" asp-action="Index" method="get">
                <input type="search" name="q" placeholder="Tìm kiếm bài viết..." value="@Context.Request.Query["q"]" aria-label="Tìm kiếm" />
                <button type="submit">Tìm</button>
            </form>

            <button class="masthead__menu-toggle" type="button" aria-controls="primary-nav" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <div id="primary-nav" class="primary-nav">
        @await Component.InvokeAsync("CategoryNav")
    </div>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <p><strong>VNews</strong> — portfolio demo, nội dung minh họa, không phải báo chí chính thức.</p>
            <p>&copy; @DateTime.Now.Year VNews. Dự án học tập / portfolio cá nhân.</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
