@using VNews.Application.Interfaces
@inject ICategoryQueryService CategoryQueryService
@{
    // Every category in the footer comes from the database; nothing here is hard-coded.
    var footerCategories = await CategoryQueryService.GetAllAsync();
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}

<footer class="site-footer" aria-label="Chân trang">
    <div class="site-footer__inner">
        <div class="site-footer__grid">
            <div class="site-footer__brand">
                <a class="site-footer__logo" asp-controller="Home" asp-action="Index" aria-label="VNews - Trang chủ">V<span>News</span></a>
                <p class="site-footer__tagline">Bản tin dành cho người thích khám phá</p>
                <p class="site-footer__about">Trang tin minh hoạ xây dựng bằng ASP.NET Core MVC, Entity Framework Core và SQL Server. <a asp-controller="Pages" asp-action="About">Tìm hiểu về dự án</a></p>
            </div>

            <nav class="site-footer__col site-footer__col--categories" aria-label="Chuyên mục">
                <h3>Chuyên mục</h3>
                <ul>
                    @foreach (var c in footerCategories)
                    {
                        <li><a asp-controller="Category" asp-action="Index" asp-route-slug="@c.Slug">@c.Name</a></li>
                    }
                </ul>
            </nav>

            <nav class="site-footer__col" aria-label="Khám phá">
                <h3>Khám phá</h3>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li><a asp-controller="Home" asp-action="Latest">Tin mới nhất</a></li>
                    <li><a asp-controller="Home" asp-action="Saved">Bài đã lưu</a></li>
                    <li><a asp-controller="Search" asp-action="Index">Tìm kiếm</a></li>
                </ul>
            </nav>

            <nav class="site-footer__col" aria-label="Tài khoản">
                <h3>Tài khoản</h3>
                <ul>
                    @if (isSignedIn)
                    {
                        <li><a asp-controller="Account" asp-action="Profile">Tài khoản của tôi</a></li>
                    }
                    else
                    {
                        <li><a asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                    }
                    <li><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/cms">Dành cho tòa soạn</a></li>
                </ul>
            </nav>

            <nav class="site-footer__col" aria-label="Về VNews">
                <h3>Về VNews</h3>
                <ul>
                    <li><a asp-controller="Pages" asp-action="About">Giới thiệu</a></li>
                    <li><a asp-controller="Pages" asp-action="Terms">Điều khoản sử dụng</a></li>
                    <li><a asp-controller="Pages" asp-action="Privacy">Chính sách bảo mật</a></li>
                </ul>
            </nav>
        </div>

        <div class="site-footer__legal">
            <p><strong>VNews</strong> là dự án học tập / portfolio cá nhân. Nội dung chỉ mang tính minh hoạ, VNews không phải cơ quan báo chí và không liên kết với VnExpress.</p>
            <p>&copy; @DateTime.Now.Year VNews. Ảnh minh hoạ dùng theo giấy phép Unsplash License (qua Picsum Photos).</p>
        </div>
    </div>
</footer>
