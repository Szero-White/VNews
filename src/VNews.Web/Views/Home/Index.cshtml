@model HomePageData
@using System.Linq
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container news-home">
    @if (Model.Hero is null)
    {
        <div class="empty-state">
            <p>Chưa có bài viết nào được xuất bản. Vui lòng chạy seed dữ liệu hoặc quay lại sau.</p>
        </div>
    }
    else
    {
        <section class="front-page" aria-label="Tin nổi bật">
            <div class="front-page__main">
                @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = Model.Hero, Layout = "image-left" })

                <div class="hero-side" aria-label="Các tin đáng chú ý">
                    @foreach (var item in Model.SideFeatures.Take(2))
                    {
                        @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = item, Layout = "hero-side-item" })
                    }
                    @foreach (var item in Model.MostViewed.Take(1))
                    {
                        @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = item, Layout = "text-only", Eyebrow = "Được quan tâm" })
                    }
                </div>
            </div>
        </section>

        var parallelSectionRendered = Model.StreamItems.Any() && Model.CategoryPanels.Any();
        @if (parallelSectionRendered)
        {
            var firstPanel = Model.CategoryPanels[0];
            var leadArticle = firstPanel.Articles.ElementAtOrDefault(0);
            var sideArticle = firstPanel.Articles.ElementAtOrDefault(1);
            var row2Articles = firstPanel.Articles.Skip(2).Take(3).ToList();

            <section class="home-parallel" aria-label="Dòng tin mới nhất và chuyên mục nổi bật">
                <div class="home-parallel__stream stream-section" aria-label="Dòng tin mới nhất">
                    <h2 class="section-title">Dòng tin mới nhất</h2>
                    <ul class="stream-list">
                        @foreach (var item in Model.StreamItems)
                        {
                            @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = item, Layout = "stream-compact" })
                        }
                    </ul>
                </div>

                <section class="home-parallel__category category-panel category-panel--first">
                    <div class="category-panel__header">
                        <h2 class="section-title">@firstPanel.Category.Name</h2>
                        <a asp-controller="Category" asp-action="Index" asp-route-slug="@firstPanel.Category.Slug" class="see-more">Xem thêm &rarr;</a>
                    </div>
                    @if (leadArticle is not null)
                    {
                        <div class="category-panel__row1">
                            @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = leadArticle, Layout = "category-lead-row1" })
                            @if (sideArticle is not null)
                            {
                                @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = sideArticle, Layout = "category-side-text" })
                            }
                        </div>
                    }
                    @if (row2Articles.Any())
                    {
                        <ul class="category-panel__row2">
                            @foreach (var item in row2Articles)
                            {
                                @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = item, Layout = "list-item" })
                            }
                        </ul>
                    }
                </section>
            </section>
        }

        <section class="content-split" aria-label="Tin tức mới và tin đọc nhiều">
            <div class="latest-list">
                <h2 class="section-title">Tin mới nhất</h2>
                @foreach (var item in Model.Latest)
                {
                    @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = item, Layout = "story-row" })
                }
            </div>

            <aside class="sidebar" aria-label="Đọc nhiều">
                <h2 class="section-title">Đọc nhiều</h2>
                <ol class="most-viewed">
                    @foreach (var item in Model.MostViewed)
                    {
                        <li>
                            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@item.Slug">@item.Title</a>
                        </li>
                    }
                </ol>
            </aside>
        </section>

        @foreach (var panel in Model.CategoryPanels.Skip(parallelSectionRendered ? 1 : 0))
        {
            <section class="category-panel">
                <div class="category-panel__header">
                    <h2 class="section-title">@panel.Category.Name</h2>
                    <a asp-controller="Category" asp-action="Index" asp-route-slug="@panel.Category.Slug" class="see-more">Xem thêm &rarr;</a>
                </div>
                <div class="category-panel__body">
                    @{ var lead = panel.Articles.First(); }
                    @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = lead, Layout = "category-lead" })
                    @if (panel.Articles.Count > 1)
                    {
                        <ul class="category-panel__list">
                            @foreach (var item in panel.Articles.Skip(1))
                            {
                                @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = item, Layout = "list-item-thumb" })
                            }
                        </ul>
                    }
                </div>
            </section>
        }

        @if (Model.PodcastDemoItems.Any())
        {
            <section class="podcast-section" aria-label="Podcasts (minh hoạ)">
                <h2 class="section-title">Podcasts</h2>
                <p class="section-note">Khu vực minh hoạ bố cục — VNews chưa tích hợp phát audio thật.</p>
                <div class="podcast-grid">
                    @foreach (var item in Model.PodcastDemoItems)
                    {
                        @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = item, Layout = "podcast-demo" })
                    }
                </div>
            </section>
        }

        @if (Model.PhotoHighlights.Any())
        {
            <section class="photo-section" aria-label="Ảnh">
                <h2 class="section-title">Ảnh</h2>
                <div class="photo-feature-row">
                    @{ var photoLead = Model.PhotoHighlights.First(); }
                    @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = photoLead, Layout = "photo-feature" })
                    <div class="photo-feature-aside-list">
                        @foreach (var item in Model.PhotoHighlights.Skip(1).Take(2))
                        {
                            @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = item, Layout = "photo-feature-aside" })
                        }
                    </div>
                </div>
            </section>
        }

        @if (Model.Spotlight.Any())
        {
            <section class="spotlight-section" aria-label="Spotlight">
                <h2 class="section-title">Spotlight</h2>
                @{ var spotlightLead = Model.Spotlight.First(); }
                @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = spotlightLead, Layout = "spotlight-feature" })
                @if (Model.Spotlight.Count > 1)
                {
                    <ul class="spotlight-list">
                        @foreach (var item in Model.Spotlight.Skip(1))
                        {
                            @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = item, Layout = "list-item" })
                        }
                    </ul>
                }
            </section>
        }
    }
</div>
