@model HomePageData
@using System.Linq
@{
    ViewData["Title"] = "Tin tức mới nhất";
    ViewData["Description"] = "VNews - Tin mới, thời sự, kinh doanh, công nghệ và đời sống.";
    // Deduplicate the first stories across hero, side features and latest stream.
    var featuredSlugs = Model.SideFeatures.Take(2).Select(a => a.Slug)
        .Append(Model.Hero?.Slug ?? string.Empty).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var newsFeed = Model.StreamItems.Concat(Model.Latest)
        .Where(article => !featuredSlugs.Contains(article.Slug))
        .GroupBy(article => article.Slug)
        .Select(group => group.First())
        .Take(18)
        .ToList();
    // The complete live stream remains accessible through the Latest route.
    // Home features a curated, finite set rather than endlessly repeated cards.
    var featuredPanels = Model.CategoryPanels.Take(6).ToList();
    var additionalPanels = Model.CategoryPanels.Skip(6).ToList();
}
<div class="container news-home news-home--v5">
    @if (Model.Hero is null)
    {
        <div class="empty-state"><p>Chưa có tin đã xuất bản. Hãy đăng bài từ CMS để bắt đầu.</p></div>
    }
    else
    {
        <section class="front-page" aria-label="Tin nổi bật">
            <div class="front-page__main">
                @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = Model.Hero, Layout = ArticleCardLayout.HeroLead, UsePageHeading = true })
                <div class="hero-side" aria-label="Tin đáng chú ý">
                    @foreach (var article in Model.SideFeatures.Take(2))
                    {
                        @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = article, Layout = ArticleCardLayout.HeroSide })
                    }
                    @foreach (var article in Model.MostViewed.Take(1))
                    {
                        @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = article, Layout = ArticleCardLayout.TextOnly, Eyebrow = "Đọc nhiều" })
                    }
                </div>
            </div>
        </section>

        @if (featuredPanels.Any())
        {
            @* One continuous stream beside the primary category panels. Remaining
           categories have working links in the compact directory below them. *@
            <div class="home-parallel" aria-label="Dòng tin và chuyên mục">
                <aside class="home-parallel__stream stream-section" aria-label="Dòng tin mới nhất">
                    <div class="editorial-heading">
                        <h2 class="section-title">Tin mới nhất</h2>
                        <a asp-controller="Home" asp-action="Latest">Xem tất cả</a>
                    </div>
                    <ul class="stream-list">
                        @foreach (var article in newsFeed)
                        {
                            @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = article, Layout = ArticleCardLayout.StreamCompact })
                        }
                    </ul>
                    <a class="view-more-link" asp-controller="Home" asp-action="Latest">Xem thêm tin <span aria-hidden="true">→</span></a>
                    <section class="today-digest" aria-label="Tin đọc nhiều">
                        <h2 class="section-title">Đọc nhiều</h2>
                        <ol class="most-viewed">
                            @foreach (var article in Model.MostViewed.Take(5))
                            {
                                <li><a asp-controller="Article" asp-action="Detail" asp-route-slug="@article.Slug">@article.Title</a></li>
                            }
                        </ol>
                    </section>
                </aside>

                <div class="home-parallel__content">
                    @foreach (var panel in featuredPanels)
                    {
                        @await Html.PartialAsync("_CategoryPanelBox", panel)
                    }
                    @if (additionalPanels.Any())
                    {
                        <section class="home-topics-directory" aria-label="Khám phá thêm chuyên mục">
                            <div class="editorial-heading">
                                <h2 class="section-title">Khám phá thêm</h2>
                            </div>
                            <ul class="home-topics-directory__links">
                                @foreach (var panel in additionalPanels)
                                {
                                    <li><a asp-controller="Category" asp-action="Index" asp-route-slug="@panel.Category.Slug">@panel.Category.Name <span aria-hidden="true">→</span></a></li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            </div>
        }

        @* Order below the stream+category zone follows the reference's real DOM order
           (confirmed via experiments/vnexpress-snapshot/): its multimedia-ish sections
           (video/vnego) come first, with the photo section appearing late, right before
           the footer — not right after the category zone like the previous order here. *@
        @if (Model.Spotlight.Any())
        {
            <section class="spotlight-section media-zone" aria-label="Tiêu điểm">
                <div class="editorial-heading"><h2 class="section-title">Tiêu điểm</h2></div>
                @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = Model.Spotlight.First(), Layout = ArticleCardLayout.SpotlightFeature })
                <ul class="spotlight-list-v2">
                    @foreach (var article in Model.Spotlight.Skip(1))
                    {
                        @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = article, Layout = ArticleCardLayout.ListItem })
                    }
                </ul>
            </section>
        }

        @if (Model.PodcastDemoItems.Any())
        {
            <section class="podcast-section media-zone" aria-label="Đọc và nghe">
                <div class="editorial-heading"><h2 class="section-title">Đọc &amp; nghe</h2></div>
                <p class="section-note">Bài viết có thể nghe bằng giọng đọc của trình duyệt trên trang chi tiết; đây không phải podcast có tệp âm thanh riêng.</p>
                <div class="podcast-grid">
                    @foreach (var article in Model.PodcastDemoItems.Take(4))
                    {
                        @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = article, Layout = ArticleCardLayout.ImageTop })
                    }
                </div>
            </section>
        }

        @if (Model.PhotoHighlights.Any())
        {
            <section class="photo-section media-zone" aria-label="Góc ảnh">
                <div class="editorial-heading">
                    <h2 class="section-title">Ảnh</h2>
                    <a asp-controller="Home" asp-action="Latest">Tin mới →</a>
                </div>
                <div class="photo-gallery-v2">
                    @foreach (var article in Model.PhotoHighlights.Take(4))
                    {
                        @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = article, Layout = ArticleCardLayout.PhotoGrid })
                    }
                </div>
            </section>
        }
    }
</div>
