@using VNews.Web.Helpers
@model PagedResult<VNews.Application.DTOs.Cms.CommentAdminItemDto>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Bình luận";
    ViewData["AppNav"] = "comments";
    ViewData["Crumbs"] = new (string, string?)[] { ("Tòa soạn", null), ("Bình luận", null) };
    var status = (string?)ViewData["Status"];
    var q = (string?)ViewData["Query"];
    var from = (DateTime?)ViewData["From"];
    var to = (DateTime?)ViewData["To"];
    var counts = (IReadOnlyDictionary<string, int>)ViewData["Counts"]!;
    int Count(string key) => counts.TryGetValue(key, out var n) ? n : 0;
    var total = Count("Visible") + Count("Hidden") + Count("Deleted");
    var hasFilter = status is not null || q is not null || from is not null || to is not null;
    var query = new Dictionary<string, string?> { ["status"] = status, ["q"] = q, ["from"] = from?.ToString("yyyy-MM-dd"), ["to"] = to?.ToString("yyyy-MM-dd") };
    string Tab(string? st) => Url.Action("Index", "CmsComments", new { status = st, q, from = from?.ToString("yyyy-MM-dd"), to = to?.ToString("yyyy-MM-dd") })!;
    var nowUtc = DateTime.UtcNow;
}
<div class="page-head">
    <div class="page-head__text">
        <h1 class="app-page-title">Bình luận</h1>
        <p class="page-head__sub">Gỡ bình luận vi phạm và khôi phục khi cần. Bình luận không bị xóa khỏi hệ thống; bình luận do chính người viết xóa thì không khôi phục được.</p>
    </div>
    <div class="page-head__actions">
        <form asp-action="HideMany" method="post" class="inline-form" hidden data-inplace="update" data-bulk-form data-bulk-status="Visible" data-bulk-template="Gỡ @@{n} bình luận đã chọn? Các bình luận sẽ không còn hiển thị công khai nhưng có thể khôi phục." data-confirm="Gỡ các bình luận đã chọn?" data-confirm-title="Gỡ bình luận" data-confirm-label="Gỡ bình luận" data-confirm-danger>
            <button type="submit" class="btn btn--danger" data-bulk-submit>Gỡ (<span data-bulk-count>0</span>)</button>
        </form>
        <form asp-action="RestoreMany" method="post" class="inline-form" hidden data-inplace="update" data-bulk-form data-bulk-status="Hidden" data-bulk-template="Khôi phục @@{n} bình luận đã chọn? Các bình luận sẽ hiển thị lại công khai." data-confirm="Khôi phục các bình luận đã chọn?" data-confirm-title="Khôi phục bình luận" data-confirm-label="Khôi phục">
            <button type="submit" class="btn btn--primary" data-bulk-submit>Khôi phục (<span data-bulk-count>0</span>)</button>
        </form>
    </div>
</div>

<section class="stats" aria-label="Thống kê bình luận">
    <a class="stat stat--pending @(status is null ? "is-current" : "")" href="@Tab(null)"><span class="stat__label">Tất cả</span><span class="stat__value" data-count="All">@total</span><span class="stat__hint">Mọi bình luận</span></a>
    <a class="stat stat--published @(status == "Visible" ? "is-current" : "")" href="@Tab("Visible")"><span class="stat__label">Đang hiển thị</span><span class="stat__value" data-count="Visible">@Count("Visible")</span><span class="stat__hint">Độc giả đang thấy</span></a>
    <a class="stat stat--rejected @(status == "Hidden" ? "is-current" : "")" href="@Tab("Hidden")"><span class="stat__label">Đã gỡ</span><span class="stat__value" data-count="Hidden">@Count("Hidden")</span><span class="stat__hint">Có thể khôi phục</span></a>
    <a class="stat stat--draft @(status == "Deleted" ? "is-current" : "")" href="@Tab("Deleted")"><span class="stat__label">Người viết đã xóa</span><span class="stat__value" data-count="Deleted">@Count("Deleted")</span><span class="stat__hint">Không khôi phục được</span></a>
</section>

<section class="card" aria-labelledby="comments-title">
    <div class="card__head">
        <h2 class="card__title" id="comments-title">@(status switch { "Visible" => "Đang hiển thị", "Hidden" => "Đã gỡ", "Deleted" => "Người viết đã xóa", _ => "Tất cả bình luận" })</h2>
        <span class="card__hint"><span data-list-total>@Model.TotalCount</span> bình luận</span>
    </div>
    <form method="get" class="filters filters--wide" role="search" aria-label="Lọc bình luận">
        <input type="hidden" name="status" value="@status" />
        <div class="filters__search">
            <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
            <label for="cmt-q" class="sr-only">Tìm bình luận</label>
            <input id="cmt-q" name="q" value="@q" maxlength="100" class="app-input" placeholder="Tìm theo nội dung, người viết hoặc bài viết" />
        </div>
        <div class="filters__dates" role="group" aria-label="Khoảng ngày viết">
            <label for="from" class="filters__datelabel">Viết từ ngày</label>
            <input id="from" name="from" type="date" class="app-input" value="@from?.ToString("yyyy-MM-dd")" />
            <label for="to" class="filters__datelabel">đến</label>
            <input id="to" name="to" type="date" class="app-input" value="@to?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn--secondary">Lọc</button>
        @if (hasFilter)
        {
            <a asp-action="Index" class="btn btn--ghost">Xóa bộ lọc</a>
        }
    </form>
    @if (Model.Items.Count == 0)
    {
        <div class="empty">
            <svg class="icon" aria-hidden="true"><use href="#i-inbox" /></svg>
            <p class="empty__title">@(hasFilter ? "Không có bình luận nào khớp bộ lọc" : "Chưa có bình luận nào")</p>
            @if (hasFilter) { <a asp-action="Index" class="btn btn--secondary">Xóa bộ lọc</a> }
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--cards cmt-table" data-filter-status="@status">
                <thead>
                    <tr>
                        <th scope="col" class="table__check"><input type="checkbox" class="app-check" data-bulk-all aria-label="Chọn tất cả bình luận trên trang này" /></th>
                        <th scope="col">Bình luận</th>
                        <th scope="col">Bài viết</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Thời gian</th>
                        <th scope="col"><span class="sr-only">Thao tác</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Items)
                    {
                        <tr data-comment-row data-id="@c.Id" data-status="@c.Status">
                            <td class="table__check">
                                @if (c.Status != "Deleted") { <input type="checkbox" class="app-check" value="@c.Id" data-bulk-item aria-label="Chọn bình luận của @c.AuthorName" /> }
                            </td>
                            <td class="cmt-cell">
                                <span class="cmt-cell__avatar" aria-hidden="true">@AppFormat.Initials(c.AuthorName)</span>
                                <div class="cmt-cell__main">
                                    <div class="cmt-cell__meta"><strong>@c.AuthorName</strong>@if (c.IsReply) { <span class="badge badge--draft">Trả lời</span> }</div>
                                    <p class="cmt-cell__text">@c.Body</p>
                                </div>
                            </td>
                            <td data-label="Bài viết" class="cmt-article">
                                @if (c.ArticleIsPublic) { <a asp-controller="Article" asp-action="Detail" asp-route-slug="@c.ArticleSlug" asp-fragment="comment-@c.Id" title="Mở bình luận trên trang bài">@c.ArticleTitle</a> }
                                else { <span>@c.ArticleTitle</span> }
                            </td>
                            <td data-label="Trạng thái">
                                <span class="badge badge--published cmt-state cmt-state--Visible">Đang hiển thị</span>
                                <span class="badge badge--rejected cmt-state cmt-state--Hidden">Đã gỡ</span>
                                <span class="badge badge--trashed cmt-state cmt-state--Deleted">Người viết đã xóa</span>
                            </td>
                            <td data-label="Thời gian" class="cmt-time"><time datetime="@VietnamTime.ToIso(c.CreatedAtUtc)" title="@VietnamTime.FormatLong(c.CreatedAtUtc)">@VietnamTime.Ago(c.CreatedAtUtc, nowUtc)</time><span>@VietnamTime.ToLocal(c.CreatedAtUtc).ToString("dd/MM/yyyy HH:mm")</span></td>
                            <td>
                                <div class="table__actions">
                                    <form asp-action="Hide" asp-route-id="@c.Id" method="post" class="inline-form cmt-action cmt-action--hide" data-inplace="update" data-confirm="Gỡ bình luận của @c.AuthorName? Bình luận sẽ không còn hiển thị công khai nhưng có thể khôi phục." data-confirm-title="Gỡ bình luận" data-confirm-label="Gỡ bình luận" data-confirm-danger>
                                        <button type="submit" class="btn btn--danger btn--sm">Gỡ</button>
                                    </form>
                                    <form asp-action="Restore" asp-route-id="@c.Id" method="post" class="inline-form cmt-action cmt-action--restore" data-inplace="update" data-confirm="Khôi phục bình luận của @c.AuthorName? Bình luận sẽ hiển thị lại công khai." data-confirm-title="Khôi phục bình luận" data-confirm-label="Khôi phục">
                                        <button type="submit" class="btn btn--secondary btn--sm">Khôi phục</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AppPager" model="@(new AppPagerModel { Page = Model.Page, PageSize = Model.PageSize, TotalCount = Model.TotalCount, Controller = "CmsComments", Query = query, Noun = "bình luận" })" />
    }
</section>

@section Scripts {
    <script src="~/js/list-actions.js" asp-append-version="true"></script>
    <script src="~/js/bulk-select.js" asp-append-version="true"></script>
}
