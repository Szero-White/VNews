@model IReadOnlyList<CategoryDto>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Chuyên mục";
    ViewData["AppNav"] = "categories";
    ViewData["Crumbs"] = new (string, string?)[] { ("Quản trị", null), ("Chuyên mục", null) };
}

<div class="page-head">
    <div class="page-head__text">
        <h1 class="app-page-title">Chuyên mục</h1>
        <p class="page-head__sub">@Model.Count chuyên mục (@Model.Count(c => c.IsChild) chuyên mục con) hiển thị trên trang tin.</p>
    </div>
    <div class="page-head__actions">
        <a asp-action="Create" class="btn btn--primary"><svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>Tạo chuyên mục</a>
    </div>
</div>

<section class="card">
    @if (Model.Count == 0)
    {
        <div class="empty">
            <svg class="icon" aria-hidden="true"><use href="#i-folder" /></svg>
            <p class="empty__title">Chưa có chuyên mục nào</p>
            <a asp-action="Create" class="btn btn--primary">Tạo chuyên mục</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--cards">
                <thead><tr><th scope="col">Tên</th><th scope="col">Chuyên mục cha</th><th scope="col">Đường dẫn</th><th scope="col">Mô tả</th><th scope="col"><span class="sr-only">Thao tác</span></th></tr></thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="table__cell-title"><span class="table__title" style="@(c.IsChild ? "padding-left:20px" : null)">@(c.IsChild ? "└ " : "")@c.Name</span></td>
                            <td data-label="Chuyên mục cha">@(c.ParentName ?? "—")</td>
                            <td data-label="Đường dẫn"><span class="table__sub">/chuyen-muc/@c.Slug</span></td>
                            <td data-label="Mô tả">@c.Description</td>
                            <td>
                                <div class="table__actions">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn--secondary btn--sm">Sửa</a>
                                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="inline-form" data-confirm="Xóa chuyên mục “@c.Name”? Chỉ xóa được khi chuyên mục không còn bài viết và không có chuyên mục con." data-confirm-title="Xóa chuyên mục" data-confirm-label="Xóa" data-confirm-danger>
                                        <button type="submit" class="btn btn--danger btn--sm">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
