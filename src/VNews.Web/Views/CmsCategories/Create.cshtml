@model CategorySaveViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Tạo chuyên mục";
    ViewData["AppNav"] = "categories";
    ViewData["Crumbs"] = new (string, string?)[] { ("Quản trị", null), ("Chuyên mục", Url.Action("Index", "CmsCategories")), ("Tạo chuyên mục", null) };
}
<div class="page-head"><div class="page-head__text"><h1 class="app-page-title">Tạo chuyên mục</h1></div></div>
<form asp-action="Create" method="post" class="card" style="max-width:640px">
    <div class="card__body">
        <partial name="_CategoryFields" model="Model" />
        <div class="app-form-actions">
            <button type="submit" class="btn btn--primary">Tạo chuyên mục</button>
            <a asp-action="Index" class="btn btn--secondary">Hủy</a>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
