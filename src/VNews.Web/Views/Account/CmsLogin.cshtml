@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập tòa soạn";
    Layout = "_CmsLayout";
}
<div class="cms-card" style="max-width:480px; margin: 48px auto;">
    <h1>Đăng nhập VNews CMS</h1>
    <p>Dành riêng cho tác giả, biên tập viên và quản trị viên.</p>
    <form asp-controller="Account" asp-action="CmsLogin" method="post" class="cms-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="cms-validation" role="alert"></div>
        <label asp-for="Email">Email nhân viên</label>
        <input asp-for="Email" type="email" autocomplete="username" />
        <span asp-validation-for="Email" class="cms-validation"></span>
        <label asp-for="Password">Mật khẩu</label>
        <input asp-for="Password" type="password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="cms-validation"></span>
        <label><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label>
        <button type="submit" class="cms-btn" style="margin-top:16px;">Đăng nhập CMS</button>
    </form>
    <p style="margin-top:16px;"><a asp-controller="Account" asp-action="Login">Đăng nhập dành cho độc giả</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
