@model ReviewActionsModel
@* Approve and reject an article that waits for review. Both ask for confirmation (reject also for a required reason) through the shared
   dialog in app-shell.js; the server re-checks that the user is an editor or admin and that the article is pending. *@
@{
    var size = Model.Small ? " btn--sm" : string.Empty;
}
<form asp-action="Publish" asp-route-id="@Model.Id" method="post" class="inline-form" data-confirm="Xuất bản bài “@Model.Title”? Bài sẽ hiển thị công khai ngay." data-confirm-title="Duyệt và xuất bản" data-confirm-label="Duyệt">
    <button type="submit" class="btn btn--primary@(size)">Duyệt</button>
</form>
<form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="inline-form js-reject-form" data-confirm="Từ chối bài “@Model.Title”. Tác giả sẽ thấy lý do này để chỉnh sửa." data-confirm-title="Từ chối bài viết" data-confirm-label="Từ chối" data-confirm-danger data-reason>
    <input type="hidden" name="reason" value="" />
    <button type="submit" class="btn btn--danger@(size)">Từ chối</button>
</form>
