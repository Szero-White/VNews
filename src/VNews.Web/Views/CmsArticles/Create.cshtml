@model ArticleSaveRequest
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Viết bài mới";
    ViewData["AppNav"] = "create";
    ViewData["Crumbs"] = new (string, string?)[] { ("Tòa soạn", null), ("Bài viết", Url.Action("Index", "CmsArticles")), ("Viết bài mới", null) };
    ViewData["Categories"] = ViewBag.Categories;
}

<div class="page-head">
    <div class="page-head__text">
        <h1 class="app-page-title">Viết bài mới</h1>
        <p class="page-head__sub">Bài được lưu thành bản nháp. Gửi duyệt khi đã sẵn sàng.</p>
    </div>
</div>

<form asp-action="Create" method="post" class="card">
    <div class="card__body">
        <partial name="_ArticleFields" model="Model" view-data="ViewData" />
        <div class="app-form-actions">
            <button type="submit" class="btn btn--primary">Tạo bản nháp</button>
            <a asp-action="Index" class="btn btn--secondary">Hủy</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_UploadScript" />
}
