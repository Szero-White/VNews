@using VNews.Web.Helpers
@using VNews.Domain.Identity
@model ArticleSaveRequest
@{
    Layout = "_AppLayout";
    var article = (ArticleEditDto)ViewBag.Article;
    var privileged = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Editor);
    var editable = article.Status is "Draft" or "Rejected";
    ViewData["Title"] = editable ? "Sửa bài viết" : "Xem bài viết";
    ViewData["AppNav"] = "articles";
    ViewData["Crumbs"] = new (string, string?)[] { ("Tòa soạn", null), ("Bài viết", Url.Action("Index", "CmsArticles")), (editable ? "Sửa bài viết" : "Xem bài viết", null) };
    ViewData["Categories"] = ViewBag.Categories;
    ViewData["ReadOnly"] = !editable;
}

<div class="page-head">
    <div class="page-head__text">
        <h1 class="app-page-title">@(editable ? "Sửa bài viết" : "Xem bài viết")</h1>
        <p class="page-head__sub"><span class="badge badge--@CmsStatus.Css(article.Status)">@CmsStatus.Label(article.Status)</span> <span>@CmsStatus.Hint(article.Status)</span></p>
    </div>
    <div class="page-head__actions">
        @if (article.Status == "Published")
        {
            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@article.Slug" class="btn btn--secondary">Xem trên trang tin</a>
        }
        @if (article.Status == "PendingReview" && privileged)
        {
            <form asp-action="Publish" asp-route-id="@article.Id" method="post" class="inline-form" data-confirm="Xuất bản bài “@article.Title”? Bài sẽ hiển thị công khai ngay." data-confirm-title="Duyệt và xuất bản" data-confirm-label="Duyệt">
                <button type="submit" class="btn btn--primary">Duyệt</button>
            </form>
            <form asp-action="Reject" asp-route-id="@article.Id" method="post" class="inline-form" data-confirm="Từ chối bài “@article.Title”. Tác giả sẽ thấy lý do này để chỉnh sửa." data-confirm-title="Từ chối bài viết" data-confirm-label="Từ chối" data-confirm-danger data-reason>
                <input type="hidden" name="reason" value="" />
                <button type="submit" class="btn btn--danger">Từ chối</button>
            </form>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(article.ReviewNote))
{
    <div class="app-alert app-alert--error" role="alert"><svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg><span>Lý do biên tập viên trả lại: @article.ReviewNote</span></div>
}

<form asp-action="Edit" asp-route-id="@article.Id" method="post" class="card">
    <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(article.RowVersion)" />
    <div class="card__body">
        <partial name="_ArticleFields" model="Model" view-data="ViewData" />
        <div class="app-form-actions">
            @if (editable)
            {
                <button type="submit" class="btn btn--primary">Lưu thay đổi</button>
            }
            <a asp-action="Index" class="btn btn--secondary">Quay lại danh sách</a>
        </div>
    </div>
</form>

@if (editable)
{
    <form asp-action="SubmitForReview" asp-route-id="@article.Id" method="post" class="card" data-confirm="Gửi bài “@article.Title” cho biên tập viên duyệt? Bạn sẽ không sửa được bài trong lúc chờ duyệt." data-confirm-title="Gửi duyệt" data-confirm-label="Gửi duyệt">
        <div class="card__body" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
            <div>
                <h2 class="card__title">Sẵn sàng đăng?</h2>
                <p class="card__hint">Lưu thay đổi trước, rồi gửi bài cho biên tập viên duyệt.</p>
            </div>
            <button type="submit" class="btn btn--primary">Gửi duyệt</button>
        </div>
    </form>
}

@section Scripts {
    <partial name="_UploadScript" />
}
