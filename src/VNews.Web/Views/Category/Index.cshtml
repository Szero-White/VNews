@model CategoryPageViewModel
@{
    ViewData["Title"] = Model.Category.Name;
    ViewData["Description"] = Model.Category.Description ?? $"Tin tức chuyên mục {Model.Category.Name} trên VNews.";
    ViewData["PaginationAction"] = "Category";
    ViewData["PaginationSlug"] = Model.Category.Slug;
}
<div class="container listing-page editorial-listing">
    <nav class="breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a> &rsaquo; @Model.Category.Name</nav>
    <div class="listing-heading">
        <div><h1 class="listing-page__title">@Model.Category.Name</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Category.Description)) { <p class="listing-page__description">@Model.Category.Description</p> }
        </div>
        <a asp-controller="Home" asp-action="Latest">Tin mới nhất →</a>
    </div>
    @if (Model.Articles.Items.Count == 0)
    {
        <div class="empty-state"><p>Chưa có bài viết trong chuyên mục này.</p></div>
    }
    else
    {
        var lead = Model.Articles.Items.First();
        @if (Model.Articles.Page == 1)
        {
            <div class="listing-feature">
                @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = lead, Layout = ArticleCardLayout.HeroLead })
            </div>
        }
        <div class="editorial-listing__articles">
            @foreach (var item in Model.Articles.Items.Skip(Model.Articles.Page == 1 ? 1 : 0))
            {
                @await Html.PartialAsync("_ArticleCard", new ArticleCardViewModel { Article = item, Layout = ArticleCardLayout.StoryRow })
            }
        </div>
        @await Html.PartialAsync("_Pagination", Model.Articles)
    }
</div>
