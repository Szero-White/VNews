@model CategoryPageViewModel
@{
    ViewData["Title"] = Model.Category.Name;
    ViewData["PaginationAction"] = "Category";
    ViewData["PaginationSlug"] = Model.Category.Slug;
}

<div class="container listing-page">
    <h1 class="listing-page__title">@Model.Category.Name</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Category.Description))
    {
        <p class="listing-page__description">@Model.Category.Description</p>
    }

    @if (Model.Articles.Items.Count == 0)
    {
        <div class="empty-state">
            <p>Chưa có bài viết nào trong chuyên mục này.</p>
        </div>
    }
    else
    {
        <div class="listing-grid">
            @foreach (var item in Model.Articles.Items)
            {
                <article class="story-row">
                    <a asp-controller="Article" asp-action="Detail" asp-route-slug="@item.Slug" class="story-row__image-link">
                        <img src="@item.CoverImageUrl" alt="@item.Title" />
                    </a>
                    <div class="story-row__body">
                        <h3 class="story-row__title">
                            <a asp-controller="Article" asp-action="Detail" asp-route-slug="@item.Slug">@item.Title</a>
                        </h3>
                        <p class="story-row__summary">@item.Summary</p>
                        <div class="article-meta">
                            <span>@item.AuthorName</span>
                            <span>@item.PublishedAt?.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </article>
            }
        </div>

        @await Html.PartialAsync("_Pagination", Model.Articles)
    }
</div>
