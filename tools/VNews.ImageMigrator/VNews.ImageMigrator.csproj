<Project Sdk="Microsoft.NET.Sdk">

  <!-- One-off tool that copies the article pictures to Cloudinary. Deliberately NOT part of VNews.slnx: the site, its tests and CI never build or run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VNews.ImageMigrator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CloudinaryDotNet" Version="1.29.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
  </ItemGroup>

</Project>
